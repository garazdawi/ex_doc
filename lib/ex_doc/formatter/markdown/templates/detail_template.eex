<%= for entry <- node.equiv_entries do %># `<%= entry.signature %> ≡ <%= entry.equiv_expr %>`
<%= for annotation <- entry.annotations do %>*<%= annotation %>* <% end %>

<% end %><%= if spec_info = node.rendered_spec_info do %># `<%= spec_info.head %>`
<% else %># `<%= node.name %>`
<% end %><%= for annotation <- node.annotations do %>*<%= annotation %>* <% end %>

<%= if deprecated = node.deprecated do %>
> This <%= node.type %> is deprecated. <%= h(deprecated) %>.
<% end %>

<%= if spec_info = node.rendered_spec_info do %>
<%= if spec_info.types != [] do %>
**Types**

<%= for {var, type} <- spec_info.types do %>
- `<%= var %>` = `<%= type %>`
<% end %>
<% end %>
<% else %>
<% all_source_specs = Enum.flat_map(node.equiv_entries, & &1.source_specs) ++ node.source_specs %>
<%= if all_source_specs != [] do %>
```<%= module.language.highlight_info().language_name %>
<%= for spec <- all_source_specs do %><%= module.language.format_spec_attribute(node) %> <%= module.language.format_spec(spec) %>
<% end %>```
<% end %>
<% end %>

<%= node_doc(node) %>
