<section class="detail" id="<%=enc node.id %>">
  <%= for {default_name, default_arity} <- node.defaults do %>
    <span id="<%=enc "#{default_name}/#{default_arity}" %>"></span>
  <% end %>
  <%= for entry <- node.equiv_entries do %>
    <span id="<%=enc entry.id %>"></span>
  <% end %>
  <div class="detail-header">
    <a href="#<%=enc node.id %>" class="detail-link" data-no-tooltip="" aria-label="Link to this <%= pretty_type(node) %>">
      <i class="ri-link-m" aria-hidden="true"></i>
    </a>
    <div class="heading-with-actions">
      <%= for entry <- node.equiv_entries do %>
        <div class="signature-row">
          <h1 class="signature" translate="no"><%=h entry.signature %><span class="signature-arrow">&nbsp;≡&nbsp;</span><span class="signature-result"><%=h entry.equiv_expr %></span></h1>
          <%= for annotation <- entry.annotations do %>
            <span class="note">(<%= annotation %>)</span>
          <% end %>
          <%= if entry.source_url do %>
            <a href="<%= entry.source_url %>" class="icon-action" rel="help nofollow" aria-label="View Source">
              <i class="ri-code-s-slash-line" aria-hidden="true"></i>
            </a>
          <% end %>
        </div>
      <% end %>
      <div class="signature-row">
        <%= if (spec_info = node.rendered_spec_info) && spec_info.head do %>
          <%= if spec_info[:head_html] do %>
            <h1 class="signature" translate="no"><%= spec_info.head %></h1>
          <% else %>
            <% [sig_part | rest] = String.split(spec_info.head, " -> ", parts: 2) %>
            <%= if rest != [] do %>
              <h1 class="signature" translate="no"><%=h sig_part %><span class="signature-arrow">&nbsp;-&gt;&nbsp;</span><span class="signature-result"><%= if spec_info[:inline_return] do %><%= spec_info.inline_return %><% else %><%=h hd(rest) %><% end %></span></h1>
            <% else %>
              <h1 class="signature" translate="no"><%=h sig_part %></h1>
            <% end %>
          <% end %>
        <% else %>
          <h1 class="signature" translate="no"><%=h node.signature %></h1>
        <% end %>
        <%= for annotation <- node.annotations do %>
          <span class="note">(<%= annotation %>)</span>
        <% end %>
        <%= if node.source_url do %>
          <a href="<%= node.source_url %>" class="icon-action" rel="help nofollow" aria-label="View Source">
            <i class="ri-code-s-slash-line" aria-hidden="true"></i>
          </a>
        <% end %>
      </div>
    </div>
  </div>
  <%= if deprecated = node.deprecated do %>
    <div class="deprecated">
      This <%= node.type %> is deprecated. <%= h(deprecated) %>.
    </div>
  <% end %>

  <section class="docstring">
    <%= if spec_info = node.rendered_spec_info do %>
      <%= if spec_info.types != [] do %>
        <div class="specs">
          <h4 class="specs-title">Types</h4>
          <%= for {var, type} <- spec_info.types do %>
            <pre translate="no"><%= var %> = <%= type %></pre>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <% all_specs = Enum.flat_map(node.equiv_entries, & &1.specs) ++ node.specs %>
      <%= if all_specs != [] do %>
        <div class="specs">
          <%= for spec <- all_specs do %>
            <pre translate="no"><span class="attribute"><%= module.language.format_spec_attribute(node) %></span> <%= spec %></pre>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= render_doc(node.doc) %>
  </section>
</section>
